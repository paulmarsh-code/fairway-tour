# Copy to .env for local runs (node --env-file=.env src/server.js) or set on your host.
# Your own server with docker compose: the site's domain, e.g. golf.example.co.uk
DOMAIN=
PORT=3000
DATA_DIR=./data

# Your contact, sent to OpenStreetMap's geocoder and in the browser user agent (required by their usage policy)
CONTACT_EMAIL=
PUBLIC_URL=

# Optional: course details from club websites, AI fallback for unusual booking pages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: review scores from Google Places
GOOGLE_PLACES_API_KEY=

# Optional: enables PATCH /api/admin/courses/:id
ADMIN_TOKEN=

# Tuning
MAX_BROWSER_PAGES=3
PER_HOST_GAP_MS=2500
TEE_SHEET_CACHE_MINUTES=20
