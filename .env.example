# Copy to .env for local runs (node --env-file=.env src/server.js) or set on your host.
# Your own server with docker compose: the site's domain, e.g. golf.example.co.uk
DOMAIN=
# Local port nginx proxies to (docker compose binds it to 127.0.0.1 only). Pick a free one.
APP_PORT=3080
PORT=3000
DATA_DIR=./data

# Your contact, sent to OpenStreetMap's geocoder and in the browser user agent (required by their usage policy)
CONTACT_EMAIL=
PUBLIC_URL=

# Optional: course details from club websites, AI fallback for unusual booking pages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# The app stops using AI for the rest of the month once its estimated spend reaches this
AI_MONTHLY_BUDGET_GBP=10
# Model price per million tokens (USD) — check anthropic.com/pricing for the model above
AI_PRICE_IN_USD=1
AI_PRICE_OUT_USD=5

# Optional: scorecards (tees, yardage, course rating, slope) and Google review scores for UK clubs
# from the UK Golf Course Data API — subscribe (free plan) at rapidapi.com/raznut303/api/uk-golf-course-data-api
UKGOLF_API_KEY=
# The free plan allows 200 calls a month; the app stops at this many
UKGOLF_MONTHLY_LIMIT=190

# Optional: review scores from Google Places
GOOGLE_PLACES_API_KEY=

# Optional: enables PATCH /api/admin/courses/:id
ADMIN_TOKEN=

# Tuning
# 2 is gentler on a server shared with other sites; raise to 3 with 4 GB+ RAM free
MAX_BROWSER_PAGES=2
PER_HOST_GAP_MS=2500
TEE_SHEET_CACHE_MINUTES=20
